# ---------------------------------------------------------------------------
# Copy this file to .env and fill it in. Never commit the filled-in .env.
# ---------------------------------------------------------------------------

# Port this service listens on.
PORT=3000
LOG_LEVEL=info

# Protects /events, /mapping and the deep health check. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Set to true to read from Pylon and log what WOULD be written, without
# touching GoHighLevel. Useful for the very first run.
DRY_RUN=false


# --- Pylon -----------------------------------------------------------------
# OPTIONAL. Team Settings > API Settings > API tokens; "read" is enough.
# Pylon only shows this once their support team has enabled API access on your
# team. Leave it blank and the bridge runs in webhook-only mode: the contact,
# the stage move and the payment data still land, and the contract value, site
# details and signed PDF are reported as warnings instead of being written.
PYLON_API_TOKEN=

# API settings > Webhook destinations. The secret is shown once, when you
# create the destination. Point the destination at:
#   https://<this-server>/webhooks/pylon
# and subscribe it to:  web_proposals.signed  and  gateway_payments.created
PYLON_WEBHOOK_SECRET=

PYLON_API_BASE=https://api.getpylon.com
PYLON_WEBHOOK_TOLERANCE_SECONDS=300
PYLON_TIMEOUT_MS=20000


# --- GoHighLevel -----------------------------------------------------------
# Settings > Private Integrations > Create. Required scopes:
#   contacts.readonly  contacts.write
#   opportunities.readonly  opportunities.write
#   locations/customFields.readonly  locations/customFields.write
#   medias.write  forms.write
GHL_API_TOKEN=

# Settings > Business Profile. The sub-account id, not the agency id.
GHL_LOCATION_ID=

GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_TIMEOUT_MS=30000

# Either the name (as it appears in the CRM) or the id. Run `npm run discover`
# to print both.
GHL_PIPELINE_NAME=
GHL_PIPELINE_ID=

# The stage an opportunity moves to when the contract is signed.
GHL_SIGNED_STAGE_NAME=
GHL_SIGNED_STAGE_ID=

# Optional: the stage to move to when a Pylon gateway payment arrives.
# Leave blank to leave the stage alone on payment.
GHL_PAID_STAGE_NAME=
GHL_PAID_STAGE_ID=

# "open" keeps the deal live in the pipeline; "won" closes it as won.
GHL_STATUS_ON_SIGNED=open

# Contact custom field (type File Upload) that receives the signed PDF itself.
GHL_CONTRACT_FILE_FIELD_KEY=contact.signed_contract_file
GHL_UPLOAD_CONTRACT_FILE=true
GHL_ADD_NOTE=true

# Optional media-library folder id to file contracts into.
GHL_MEDIA_FOLDER_ID=


# --- Success / failure callback (optional) ---------------------------------
# Every processed event POSTs a short JSON summary here, HMAC-signed with
# BRIDGE_CALLBACK_SECRET. Point it at a GoHighLevel inbound webhook, Zapier, Slack
# relay, or leave blank to rely on the /events log alone.
BRIDGE_CALLBACK_URL=
BRIDGE_CALLBACK_SECRET=


# --- Retry behaviour -------------------------------------------------------
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_SECONDS=10,60,300,1800,3600
QUEUE_CONCURRENCY=2

# Where the event log lives, and how long a successful event is kept.
DATA_DIR=data
EVENT_RETENTION_DAYS=90
