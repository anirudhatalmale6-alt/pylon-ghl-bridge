{
  "version": 1,
  "description": "Pylon -> GoHighLevel field map. Edit the RIGHT-hand side to change where a value lands. Left-hand keys are GoHighLevel custom fields, referenced by field key, field name, or raw id. Run `npm run discover` to print every field available in your account.",
  "writeEmptyValues": false,

  "events": {
    "web_proposals.signed": {
      "contact": {
        "standard": {
          "firstName": "{{client.first_name}}",
          "lastName": "{{client.last_name}}",
          "name": "{{client.name}}",
          "email": "{{client.email || client.project_contact_email}}",
          "phone": "{{client.phone}}",
          "address1": "{{client.address.line1}}",
          "city": "{{client.address.city}}",
          "state": "{{client.address.state}}",
          "postalCode": "{{client.address.postcode}}",
          "country": "{{client.address.country_code}}",
          "source": "Pylon - contract signed"
        },
        "tags": ["contract-signed"],
        "customFields": {
          "contact.pylon_project_reference": "{{project.reference_number}}",
          "contact.pylon_project_link": "{{project.in_app_url}}",
          "contact.signed_contract_pdf": "{{contract.signed_pdf_stored_url}}"
        }
      },

      "opportunity": {
        "name": "{{contract.name}} - {{client.address.line1 || client.name}}",
        "monetaryValue": "{{contract.total_amount}}",
        "status": "open",
        "stage": "signed",
        "customFields": {
          "opportunity.contract_reference": "{{project.reference_number}}",
          "opportunity.contract_value": "{{contract.total_amount}}",
          "opportunity.contract_currency": "{{contract.currency}}",
          "opportunity.contract_signed_date": "{{contract.signed_at | date}}",
          "opportunity.signed_by": "{{contract.signer_name || client.name}}",
          "opportunity.signed_by_email": "{{contract.signer_email || client.email}}",
          "opportunity.signed_contract_pdf": "{{contract.signed_pdf_stored_url}}",
      "opportunity.signed_contract_file": "{{contract.signed_pdf_stored_url}}",
          "opportunity.system_size_kw": "{{contract.system_size_kw}}",
          "opportunity.battery_storage_kwh": "{{contract.storage_kwh}}",
          "opportunity.deposit_amount": "{{contract.deposit_amount_formatted}}",
          "opportunity.amount_payable": "{{contract.amount_payable_formatted}}",
          "opportunity.install_address": "{{client.address.full}}",
          "opportunity.pylon_project_link": "{{project.in_app_url}}",
          "opportunity.web_proposal_link": "{{contract.proposal_web_url}}"
        }
      },

      "invoice": {
      "name": "{{contract.name}} - {{project.reference_number}}",
      "currency": "{{contract.currency || 'AUD'}}",
      "items": [
        {
          "name": "{{contract.name}}",
          "description": "{{contract.description || contract.title}} — Pylon reference {{project.reference_number}}",
          "amount": "{{contract.total_amount}}",
          "qty": 1
        }
      ]
    },
    "note": "Contract signed in Pylon on {{contract.signed_at | date}}.\nSigned by: {{contract.signer_name}} ({{contract.signer_email}})\nSystem: {{contract.description || contract.title}}\nContract value: {{contract.total_amount_formatted}}\nDeposit: {{contract.deposit_amount_formatted}}\nPylon reference: {{project.reference_number}}\nSigned contract: {{contract.signed_pdf_stored_url}}\nPylon project: {{project.in_app_url}}"
    },

    "gateway_payments.created": {
      "contact": {
        "standard": {
          "email": "{{client.email}}",
          "phone": "{{client.phone}}"
        },
        "tags": ["payment-received"],
        "customFields": {}
      },

      "opportunity": {
        "monetaryValue": null,
        "status": null,
        "stage": "paid",
        "customFields": {
          "opportunity.payment_received": "{{payment.amount}}",
          "opportunity.payment_type": "{{payment.purpose_label}}",
          "opportunity.payment_date": "{{payment.received_at | date}}",
          "opportunity.payment_receipt_link": "{{payment.receipt_url}}"
        }
      },

      "note": "Payment received through Pylon on {{payment.received_at | date}}.\nType: {{payment.purpose_label}}\nAmount: {{payment.amount_formatted}}\nReceipt: {{payment.receipt_url}}\nPylon reference: {{project.reference_number}}"
    }
  }
}
